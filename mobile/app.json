{
  "expo": {
    "name": "AfriCart",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/africart-icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B6B4A",
        "foregroundImage": "./assets/images/africart-adaptive-foreground.png",
        "monochromeImage": "./assets/images/africart-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.mobile"
    },
    "web": {
      "name": "AfriCart",
      "shortName": "AfriCart",
      "description": "Shop quality products with AfriCart.",
      "output": "static",
      "favicon": "./assets/images/africart-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/africart-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B6B4A",
          "dark": {
            "backgroundColor": "#0B6B4A"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "ecommerce-tut",
          "organization": "codesistency-gs"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
