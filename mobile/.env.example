# Copy to mobile/.env and fill in real values.
# EXPO_PUBLIC_* values are bundled into the app and are visible to users.

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=<YOUR_CLERK_PUBLISHABLE_KEY>

# Use a backend URL reachable from your device/emulator.
# Android emulator: http://10.0.2.2:3000/api
# Physical device: http://<YOUR_COMPUTER_LAN_IP>:3000/api
# Production: https://<PUBLIC_BACKEND_DOMAIN>/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Optional Sentry DSN for error monitoring
EXPO_PUBLIC_SENTRY_DSN=
