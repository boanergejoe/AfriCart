{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "env -u npm_config_cache_dir npm ci",
  "buildCommand": "EXPO_PUBLIC_API_URL=https://afri-cart-two.vercel.app/api npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/product/:id",
      "destination": "/product?id=:id"
    }
  ]
}
