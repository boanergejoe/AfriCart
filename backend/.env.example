# Copy to backend/.env and fill in real values. Never commit the filled-in file.

NODE_ENV=development
PORT=3000

DB_URL=<YOUR_MONGODB_CONNECTION_STRING>

CLERK_SECRET_KEY=<YOUR_CLERK_SECRET_KEY>

# CLIENT_URL is the admin dashboard origin. MOBILE_CLIENT_URL is the customer
# storefront origin; it is used for CORS and PesaPal payment callback redirects.
# Production: CLIENT_URL=https://afri-cart-cfe2.vercel.app
# Production: MOBILE_CLIENT_URL=https://africart-mobile-five.vercel.app
CLIENT_URL=http://localhost:5173
MOBILE_CLIENT_URL=http://localhost:8081

# Product image uploads (server-side only)
CLOUDINARY_CLOUD_NAME=<YOUR_CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<YOUR_CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<YOUR_CLOUDINARY_API_SECRET>

# Background jobs (optional; leave empty to disable Inngest locally)
INNGEST_SIGNING_KEY=

# Admin dashboard password login (NOT Clerk). Generate both values with:
# npm run admin:credentials
ADMIN_EMAIL=<YOUR_ADMIN_EMAIL>
ADMIN_PASSWORD_HASH=<SCRYPT_HASH_FROM_ADMIN_CREDENTIALS_SCRIPT>
ADMIN_SESSION_SECRET=<RANDOM_SECRET_FROM_ADMIN_CREDENTIALS_SCRIPT>

# PesaPal checkout (server-side only)
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=<YOUR_PESAPAL_CONSUMER_KEY>
PESAPAL_CONSUMER_SECRET=<YOUR_PESAPAL_CONSUMER_SECRET>
PESAPAL_CURRENCY=USD
PESAPAL_IPN_URL=https://<PUBLIC_BACKEND_DOMAIN>/api/payment/pesapal/ipn
PESAPAL_IPN_ID=<REGISTERED_IPN_ID>
PESAPAL_CALLBACK_URL=https://<PUBLIC_BACKEND_DOMAIN>/api/payment/pesapal/callback

# Optional: delivery method used only when registering a new IPN (GET or POST).
PESAPAL_IPN_NOTIFICATION_TYPE=GET
